# ===== 敏感配置（复制为 .env 并填入真实值；.env 不进版本库）=====
# LLM（OpenAI 兼容接口，示例为 DeepSeek）
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Redis 密码（与 docker compose 的 requirepass 保持一致）
REDIS_PASSWORD=1234

# ===== 远程 BGE 服务（SiliconFlow，bge-m3 1024 维 / bge-reranker-v2-m3）=====
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# MySQL（数据库工具）
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=aiops

# ===== 可选：本地模型路径覆盖（默认无需配置）=====
# EMBEDDING_MODEL_PATH=D:\AIOps\task\all-MiniLM-L6-v2
# RERANKER_MODEL_PATH=D:\AIOps\task\ms-marco-MiniLM-L-6-v2
